# Copy to .env for local development. Never commit real values.

# ---------------------------------------------------------------------------
# Required (local and production)
# ---------------------------------------------------------------------------
DB_USERNAME=
DB_PASSWORD=

# At least 32 characters (HMAC-SHA256 signing key).
JWT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Required in production only (locally the dev profile supplies these)
# ---------------------------------------------------------------------------
# "prod" in production. Locally, run with the dev profile instead.
SPRING_PROFILES_ACTIVE=
# JDBC form, e.g. jdbc:mysql://host:3306/database
DB_URL=
# Public base URL used for Stripe's success/cancel redirects, no trailing slash.
WEBSITE_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Email of the shared public demo account; visitors can't change or delete it.
# Leave empty to protect no account.
DEMO_ACCOUNT_EMAIL=
# Overrides the fixed demo DKK -> EUR rate (default 0.1340).
STORE_CURRENCY_DKKTOEURRATE=
